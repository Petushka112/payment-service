# Copy to .env and adjust. Every variable has a sane default in docker-compose.yml.

# --- security ---
API_KEY=secret-api-key
# If set, webhooks carry an HMAC-SHA256 signature in X-Webhook-Signature
WEBHOOK_SECRET=

# --- local (non-docker) run ---
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- retry / DLQ ---
# Total attempts per message (including the first). Changing this or the delays after
# the queues exist requires removing the payments.retry.* queues (docker compose down -v).
MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2
RETRY_BACKOFF_FACTOR=2

# --- gateway emulation ---
GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5
GATEWAY_SUCCESS_RATE=0.9

WEBHOOK_TIMEOUT=5
LOG_LEVEL=INFO

# --- host ports used by docker-compose ---
API_PORT=8000
WEBHOOK_RECEIVER_PORT=9000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
